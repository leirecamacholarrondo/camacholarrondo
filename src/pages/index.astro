---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="home">
		<div class="background-glow glow-one"></div>
		<div class="background-glow glow-two"></div>

		<nav>
			<div class="logo">CL</div>
			<span>Camacho Larrondo</span>
		</nav>

		<section class="hero">
			<p class="eyebrow">SOFTWARE · TECHNOLOGY · ENGINEERING</p>

			<h1>
				Camacho<br />
				<span>Larrondo</span>
			</h1>

			<p class="intro">
				A shared space for our projects, ideas,
				articles and everything we're building.
			</p>
		</section>

		<section class="profiles">
			<a href="/leire" class="profile leire">
				<div class="profile-number">01</div>

				<div class="profile-content">
					<p class="profile-label">PORTFOLIO & BLOG</p>
					<h2>Leire</h2>
					<p class="description">
						Software engineering, C++, graphics,
						algorithms and concepts I'm learning.
					</p>
				</div>

				<div class="arrow">↗</div>
			</a>

			<a href="/aitor" class="profile aitor">
				<div class="profile-number">02</div>

				<div class="profile-content">
					<p class="profile-label">PORTFOLIO & BLOG</p>
					<h2>Aitor</h2>
					<p class="description">
						Projects, ideas, technical articles
						and everything I'm working on.
					</p>
				</div>

				<div class="arrow">↗</div>
			</a>
		</section>

		<footer>
			<span>© 2026 Camacho Larrondo</span>
			<span>Bilbao · Spain</span>
		</footer>
	</main>
</Layout>

<style>
	:global(body) {
		margin: 0;
		background: #08090b;
		color: #f2f2f2;
		font-family:
			Inter,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
	}

	.home {
		position: relative;
		min-height: 100vh;
		overflow: hidden;
		padding: 0 6vw;
		box-sizing: border-box;
		background:
			radial-gradient(
				circle at 20% 20%,
				rgba(255, 255, 255, 0.045),
				transparent 30%
			),
			#08090b;
	}

	/* Background */

	.background-glow {
		position: absolute;
		width: 500px;
		height: 500px;
		border-radius: 50%;
		filter: blur(120px);
		pointer-events: none;
		opacity: 0.12;
	}

	.glow-one {
		top: -250px;
		left: -200px;
		background: #7c3aed;
	}

	.glow-two {
		right: -250px;
		bottom: -250px;
		background: #2563eb;
	}

	/* Navigation */

	nav {
		position: relative;
		z-index: 1;

		display: flex;
		align-items: center;
		gap: 1rem;

		padding-top: 2rem;

		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.6);
	}

	.logo {
		display: grid;
		place-items: center;

		width: 38px;
		height: 38px;

		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 50%;

		font-size: 0.7rem;
		font-weight: 600;
		color: white;
	}

	/* Hero */

	.hero {
		position: relative;
		z-index: 1;

		max-width: 1000px;
		padding-top: 13vh;
		padding-bottom: 8vh;
	}

	.eyebrow {
		margin: 0 0 1.5rem;

		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		color: rgba(255, 255, 255, 0.45);
	}

	h1 {
		margin: 0;

		font-size: clamp(4.5rem, 11vw, 10rem);
		font-weight: 500;
		letter-spacing: -0.07em;
		line-height: 0.82;
	}

	h1 span {
		color: rgba(255, 255, 255, 0.32);
	}

	.intro {
		max-width: 550px;
		margin: 3rem 0 0;

		font-size: clamp(1.05rem, 2vw, 1.3rem);
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.55);
	}

	/* Profiles */

	.profiles {
		position: relative;
		z-index: 1;

		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;

		max-width: 1200px;
		margin: 0 auto;
	}

	.profile {
		position: relative;

		display: flex;
		flex-direction: column;
		justify-content: space-between;

		min-height: 380px;
		padding: 2rem;

		box-sizing: border-box;

		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 20px;

		background: rgba(255, 255, 255, 0.035);
		backdrop-filter: blur(10px);

		color: white;
		text-decoration: none;

		overflow: hidden;

		transition:
			transform 0.35s ease,
			border-color 0.35s ease,
			background 0.35s ease;
	}

	.profile::before {
		content: "";

		position: absolute;
		inset: 0;

		background: radial-gradient(
			circle at 80% 20%,
			rgba(255, 255, 255, 0.08),
			transparent 35%
		);

		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.profile:hover {
		transform: translateY(-8px);
		border-color: rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.06);
	}

	.profile:hover::before {
		opacity: 1;
	}

	.profile-number {
		position: relative;
		z-index: 1;

		font-size: 0.75rem;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.35);
	}

	.profile-content {
		position: relative;
		z-index: 1;
	}

	.profile-label {
		margin: 0 0 0.8rem;

		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.18em;

		color: rgba(255, 255, 255, 0.4);
	}

	.profile h2 {
		margin: 0;

		font-size: clamp(3rem, 5vw, 5rem);
		font-weight: 400;
		letter-spacing: -0.06em;
	}

	.description {
		max-width: 400px;
		margin: 1rem 0 0;

		font-size: 0.95rem;
		line-height: 1.6;

		color: rgba(255, 255, 255, 0.5);
	}

	.arrow {
		position: absolute;
		z-index: 1;

		right: 2rem;
		bottom: 1.7rem;

		font-size: 2rem;
		font-weight: 200;

		color: rgba(255, 255, 255, 0.5);

		transition:
			transform 0.35s ease,
			color 0.35s ease;
	}

	.profile:hover .arrow {
		transform: translate(5px, -5px);
		color: white;
	}

	/* Footer */

	footer {
		position: relative;
		z-index: 1;

		display: flex;
		justify-content: space-between;

		margin-top: 5rem;
		padding: 2rem 0;

		border-top: 1px solid rgba(255, 255, 255, 0.08);

		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;

		color: rgba(255, 255, 255, 0.3);
	}

	/* Mobile */

	@media (max-width: 700px) {
		.home {
			padding: 0 1.5rem;
		}

		nav {
			padding-top: 1.5rem;
		}

		.hero {
			padding-top: 15vh;
			padding-bottom: 10vh;
		}

		h1 {
			font-size: clamp(4rem, 19vw, 7rem);
		}

		.profiles {
			grid-template-columns: 1fr;
		}

		.profile {
			min-height: 320px;
		}

		footer {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>