---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="home">
		<header>
			<h1>Camacho Larrondo</h1>
			<p>Personal portfolios &amp; blogs</p>
		</header>

		<section class="profiles">
			<a href="/leire" class="profile">
				<h2>Leire</h2>
				<span>Portfolio &amp; Blog</span>
			</a>

			<a href="/aitor" class="profile">
				<h2>Aitor</h2>
				<span>Portfolio &amp; Blog</span>
			</a>
		</section>
	</main>
</Layout>

<style>
	.home {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 2rem;
	}

	header {
		text-align: center;
		margin-bottom: 4rem;
	}

	h1 {
		font-size: 4rem;
		margin: 0;
	}

	header p {
		font-size: 1.2rem;
		opacity: 0.6;
	}

	.profiles {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
		width: min(900px, 100%);
	}

	.profile {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 300px;
		border: 1px solid #333;
		border-radius: 16px;
		text-decoration: none;
		color: inherit;
		transition: transform 0.2s, border-color 0.2s;
	}

	.profile:hover {
		transform: translateY(-8px);
		border-color: #888;
	}

	.profile h2 {
		font-size: 2.5rem;
		margin: 0 0 0.5rem;
	}

	.profile span {
		opacity: 0.6;
	}

	@media (max-width: 700px) {
		.profiles {
			grid-template-columns: 1fr;
		}

		h1 {
			font-size: 2.8rem;
		}
	}
</style>